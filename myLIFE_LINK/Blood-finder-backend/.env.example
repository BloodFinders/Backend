PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/lifelink
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars

# SMTP Config (for sending verification emails)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL=your_smtp_email
SMTP_PASSWORD=your_smtp_password
FROM_EMAIL=noreply@lifelink.com
FROM_NAME=LifeLink

# ── Rate Limiting (all values are in milliseconds for window, counts for max) ──
# General API rate limit (all /api/* routes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Strict auth rate limit (login, register, forgot-password)
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=10

# OTP rate limit (verify-otp, reset-password)
OTP_RATE_WINDOW_MS=600000
OTP_RATE_MAX=5
